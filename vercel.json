{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/extension-privacy\\.html$",
      "headers": { "Location": "/privacy" },
      "status": 308
    },
    {
      "src": "^/privacy/?$",
      "dest": "/extension-privacy.html"
    },
    {
      "src": "^/$",
      "dest": "/october/index.html"
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
